{
  "name": "gos-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-theme-surfaces.mjs && tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "i18n:catalog": "node scripts/build-display-catalog.mjs",
    "i18n:check": "node scripts/verify-localization.mjs",
    "preview": "vite preview",
    "test:backend": "node --test functions/policy.test.js",
    "test:firebase-ui": "node tests/firebase-dashboard-browser.test.mjs",
    "test:firebase-rules": "node tests/firebase-rules-emulator.test.mjs",
    "seed:firebase": "node functions/seed.mjs",
    "firebase:catalog": "node scripts/export-template-catalog.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.3.7",
    "@reduxjs/toolkit": "^2.13.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.6",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
