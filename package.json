{
  "name": "upclick-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:admin": "node --test tests/admin-safety.test.mjs functions/impersonation.test.js",
    "test:admin:browser": "node tests/admin-switch-browser.test.mjs",
    "test:gos-api": "node --test tests/gos-api.test.mjs tests/crm-booking-stage.test.mjs",
    "test:storage": "node --test tests/storage-resilience.test.mjs",
    "test:builder-storage": "node tests/builder-storage-browser.test.mjs",
    "test:published-hosting": "node tests/published-hosting-browser.test.mjs",
    "smoke:gos-api": "node scripts/smoke-gos-api.mjs",
    "dev": "node scripts/build-phoenix-brand.mjs && vite",
    "build": "node scripts/build-theme-surfaces.mjs && node scripts/build-phoenix-brand.mjs && tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "i18n:catalog": "node scripts/build-display-catalog.mjs",
    "i18n:check": "node scripts/verify-localization.mjs",
    "preview": "vite preview",
    "test:backend": "node --test functions/policy.test.js",
    "test:firebase-ui": "node tests/firebase-dashboard-browser.test.mjs",
    "test:firebase-rules": "node tests/firebase-rules-emulator.test.mjs",
    "seed:firebase": "node functions/seed.mjs",
    "firebase:catalog": "node scripts/export-template-catalog.mjs",
    "test:crm": "node --test tests/gos-api.test.mjs tests/crm-booking-stage.test.mjs tests/crm-model.test.cjs tests/crm-persistence.test.mjs tests/crm-id-sync.test.mjs",
    "test:crm:browser": "node tests/crm-workspace-browser.test.mjs"
