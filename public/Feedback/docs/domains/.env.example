# ==============================================================================
# Custom Domain Environment Variables
# ==============================================================================

# 1. DNS Target Hosts
# The CNAME target where users point their subdomains (e.g. offers.clientbrand.com)
NEXT_PUBLIC_SITES_CNAME=cname.vercel-dns.com
SITES_CNAME_TARGET=cname.vercel-dns.com

# The A-Record IP where users point their root/apex domains (e.g. clientbrand.com)
NEXT_PUBLIC_SITES_A_RECORD_IP=76.76.21.21
SITES_A_RECORD_IP=76.76.21.21

# 2. Platform Host Exclusions
# Comma-separated platform domains that should NOT be rewritten as custom domains
NEXT_PUBLIC_APP_HOSTS=upklick.net,www.upklick.net,app.upklick.net,upklick.com,www.upklick.com,app.upklick.com

# 3. Vercel Auto-Provisioning (Optional but Recommended)
# Allows the API to automatically register custom domains on Vercel for instant SSL issuance
VERCEL_TOKEN=your_vercel_api_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
VERCEL_TEAM_ID=your_vercel_team_id_here # (Optional, only if using a Vercel Team)

# 4. Firebase Authentication OAuth Authorized Domains (Optional)
# Automatically whitelists customer domains in Firebase Auth authorizedDomains
FIREBASE_PROJECT_ID=upklick-software
# Optional Service Account credentials:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# OR:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
