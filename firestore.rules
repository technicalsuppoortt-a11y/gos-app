rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function platformOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.phoenixUid is string;
    }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function accountAvailable() {
      return request.auth != null && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !(profile().get('status', 'Active') in ['Deactivated', 'deactivated', 'Inactive', 'inactive', 'Suspended', 'suspended', 'Deleted', 'deleted']));
    }
    function platformStaff() {
      return request.auth != null && (request.auth.token.get('role', '') in ['PLATFORM_SUPPORT', 'PLATFORM_FINANCE'] ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['PLATFORM_SUPPORT', 'PLATFORM_FINANCE']);
    }
    function signedIn() {
      return accountAvailable() && !platformStaff() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        profile().get('status', 'Active') in ['Active', 'active', 'Activated', 'activated'] ||
        profile().get('role', '') in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'platform_admin']
      );
    }
    function member(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data; }
    function tenant(tenantId) {
      return featureAdmin() || (signedIn() && (
        request.auth.uid == tenantId ||
        request.auth.token.get('tenantId', '') == tenantId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('tenantId', '') == tenantId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'platform_admin']) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) && member(tenantId).get('active', false) == true) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) && member(tenantId).get('role', '') in ['Owner', 'owner', 'Admin', 'admin']) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)) && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ownerUid', '') == request.auth.uid) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)) && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ownerId', '') == request.auth.uid)
      ));
    }
    function permit(tenantId, permission) {
      return featureAdmin() || (tenant(tenantId) && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'platform_admin']) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) && member(tenantId).get('role', '') in ['Owner', 'owner', 'Admin', 'admin']) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)) && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ownerUid', '') == request.auth.uid) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)) && get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ownerId', '') == request.auth.uid) ||
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) && member(tenantId).get('permissions', []).hasAny(['*', permission])) ||
        (permission == 'funnels' && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) && member(tenantId).get('permissions', []).hasAny(['forms', 'websites']))
      ));
    }
    function canRead(tenantId, collectionName) {
      return featureAdmin() || permit(tenantId, 'analytics') ||
        collectionName in ['products', 'discounts', 'transactions', 'orders', 'checkoutRequests'] && permit(tenantId, 'products') ||
        collectionName in ['calendars', 'bookings'] && permit(tenantId, 'booking') ||
        collectionName in ['leads', 'contacts', 'pipelines'] && permit(tenantId, 'crm') ||
        collectionName in ['conversations', 'messages'] && permit(tenantId, 'inbox') ||
        collectionName in ['workflows', 'templates', 'workflowRuns', 'scheduledActions'] && permit(tenantId, 'follow-up') ||
        collectionName in ['knowledge', 'integrations', 'auditLogs'] && permit(tenantId, 'settings') ||
        collectionName in ['assets', 'domains'] && permit(tenantId, 'funnels') ||
        collectionName == 'copilotConversations' && permit(tenantId, 'copilot') ||
        collectionName in ['events', 'userTemplates'] && permit(tenantId, 'home') ||
        collectionName == 'files' && permit(tenantId, 'products');
    }
    match /settings/platformTools {
      allow read: if signedIn() || platformTeamCan(['templates']);
      allow write: if featureAdmin() && request.resource.data.keys().hasOnly(['tools', 'revision', 'updatedAt', 'updatedBy']) && request.resource.data.tools is map && request.resource.data.tools.size() <= 12 && request.resource.data.revision is int && request.resource.data.updatedBy == request.auth.uid;
    }
    match /settings/adminGeneral { allow read, write: if featureAdmin(); }
    function validDashboardBrand() {
      let d = request.resource.data;
      let v = d.get('values', {});
      return v is map
        && v.get('name', '') is string && v.get('name', '').size() <= 180
        && v.get('theme', 'violet') in ['violet', 'slate', 'midnight', 'emerald', 'amber', 'ocean', 'royal', 'crimson', 'cyber', 'minimalist']
        && v.get('language', 'en') in ['en', 'ar']
        && v.get('mode', 'system') in ['light', 'dark', 'system'];
    }
    // The public landing page reads only the platform's presentation defaults.
    match /settings/publicAppearance {
      allow get: if true;
      allow create, update: if featureAdmin()
        && request.resource.data.keys().hasOnly(['values'])
        && request.resource.data.values.keys().hasOnly(['name', 'logoUrl', 'theme', 'language', 'currency', 'mode', 'timezone'])
        && validDashboardBrand();
    }
    // Public-to-linked-clients preference projection; contains no account or SMTP data.
    match /dashboardBrands/{providerId} {
      allow read: if signedIn() && (request.auth.uid == providerId || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('supportParentId', '') == providerId));
      allow create, update: if signedIn() && (featureAdmin() || superAdmin())
        && request.resource.data.updatedBy == request.auth.uid && validDashboardBrand();
      allow delete: if signedIn() && (featureAdmin() || superAdmin() || request.auth.uid == providerId);
    }
    match /supportRooms/{roomId} {
      allow read: if (signedIn() || platformRole(['PLATFORM_SUPPORT'])) && request.auth.uid in resource.data.participants;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if (signedIn() || platformRole(['PLATFORM_SUPPORT'])) && request.auth.uid in get(/databases/$(database)/documents/supportRooms/$(roomId)).data.participants;
        allow write: if false;
      }
    }
    match /settings/paymentMethods {
      allow read: if true;
      allow write: if platformSuperadmin() || platformFinance() || superAdmin();
    }
    // Credential values are accessible only through authenticated, admin-only callables.
    match /paymentGatewayConfigurations/{provider} { allow read, write: if false; }
    // Billing: plans, subscriptions, wallets, ledger and requests are server-owned (billingService callable).
    function superAdmin() {
      return accountAvailable() && !platformStaff() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['SUPER_ADMIN', 'ADMIN', 'super_admin', 'admin', 'platform_admin', 'Owner', 'owner']) ||
        request.auth.token.get('role', '') in ['SUPER_ADMIN', 'ADMIN', 'super_admin', 'admin', 'platform_admin', 'Owner', 'owner']
      );
    }
    function featureAdmin() {
      return accountAvailable() && !platformStaff() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'Admin', 'Owner', 'owner', 'platform_admin']) ||
        request.auth.token.get('role', '') in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'Admin', 'Owner', 'owner', 'platform_admin'] ||
        superAdmin()
      );
    }
    function platformRole(roles) {
      return accountAvailable() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profile().get('status', 'Active') in ['Active', 'active', 'Activated', 'activated'] && profile().get('role', '') in roles;
    }
    function platformTeamTabs() {
      let custom = exists(/databases/$(database)/documents/settings/teamMemberPermissions)
        ? get(/databases/$(database)/documents/settings/teamMemberPermissions).data.get('members', {}).get(request.auth.uid, {})
        : {};
      return custom.get('allowedTabs', profile().get('allowedTabs', request.auth.token.get('allowedTabs', [])));
    }
    function platformTeamCan(tabs) {
      return platformRole(['SUPER_ADMIN', 'super_admin', 'PLATFORM_SUPPORT', 'PLATFORM_FINANCE']) && (
        profile().get('role', '') in ['SUPER_ADMIN', 'super_admin'] ||
        platformTeamTabs().hasAny(tabs)
      );
    }
    function platformSuperadmin() { return platformRole(['SUPER_ADMIN', 'super_admin']) || platformTeamCan(['overview', 'all_admins', 'team_management', 'system_settings']); }
    function platformFinance() { return platformRole(['PLATFORM_FINANCE']) || platformTeamCan(['overview', 'plans_billing', 'usage_revenue', 'meta_wallet', 'payments']); }
    match /settings/platformOperations {
      allow get: if platformSuperadmin();
      allow write: if false;
    }
    match /userManagementAudit/{entryId} {
      allow read: if platformSuperadmin() || platformRole(['PLATFORM_SUPPORT']) || platformTeamCan(['logs_monitoring', 'overview']);
      allow write: if false;
    }
    match /{path=**}/transactions/{entryId} {
      allow read: if platformSuperadmin() || platformFinance();
    }
    function billingParty(subscriberId, providerId) {
      return signedIn() && (
        request.auth.uid == subscriberId ||
        request.auth.uid == providerId ||
        featureAdmin() ||
        superAdmin()
      );
    }
    function agencyWorkspace(tenantId) {
      let path = /databases/$(database)/documents/tenants/$(tenantId);
      return exists(path) && get(path).data.get('accountType', '') == 'agency';
    }
    function agencyUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('accountType', '') == 'agency';
    }
    match /billingPlans/{planId} {
      allow read: if superAdmin() || featureAdmin() || signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == 'platform' ||
        profile().role in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin'] ||
        profile().role == 'USER' && resource.data.ownerId == profile().get('supportParentId', ''));
      allow write: if false;
    }
    match /billingSubscriptions/{subscriberId} {
      allow read: if platformSuperadmin() || platformFinance() || signedIn() && (request.auth.uid == subscriberId || featureAdmin() || billingParty(subscriberId, resource.data.providerId));
      allow write: if false;
    }
    match /billingWallets/{walletId} {
      allow read: if signedIn() && (request.auth.uid == walletId || featureAdmin() || billingParty(walletId, resource.data.providerId));
      allow write: if false;
    }
    match /billingLedger/{entryId} {
      allow read: if signedIn() && (featureAdmin() || billingParty(resource.data.walletId, resource.data.providerId));
      allow read: if platformFinance() && resource.data.type == 'usage';
      allow write: if false;
    }
    match /add_on_requests/{requestId} {
      allow read: if signedIn() && (featureAdmin() || billingParty(resource.data.requesterId, resource.data.providerId));
      allow write: if false;
    }
    match /billingRequests/{requestId} {
      allow read: if signedIn() && (featureAdmin() || billingParty(resource.data.requesterId, resource.data.providerId));
      allow read: if platformFinance();
      allow write: if false;
    }
    match /billingSettings/{providerId} { allow read: if providerId != 'creditWeights' && signedIn(); allow write: if false; }
    match /billingCoupons/{couponId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.ownerId == 'platform' ||
        profile().role in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin']
      );
      allow write: if false;
    }
    match /couponRedemptions/{redemptionId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        profile().role in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin']
      );
      allow write: if false;
    }
    // Communication Wallet (external carrier costs) — separate from plan credits; server-owned.
    match /communicationWallets/{walletId} {
      allow read: if signedIn() && (request.auth.uid == walletId || featureAdmin() || billingParty(walletId, resource.data.providerId));
      allow get: if platformFinance() && walletId == 'platform';
      allow list: if platformFinance() && resource.data.providerId == 'platform';
      allow write: if false;
    }
    match /communicationLedger/{entryId} {
      allow read: if superAdmin() || featureAdmin() || (signedIn() && (
        request.auth.uid == resource.data.tenant_id ||
        request.auth.uid == resource.data.subscriber_id && (!agencyUser() || resource.data.get('wallet_id', resource.data.subscriber_id) == resource.data.subscriber_id)
      ));
      allow write: if false;
    }
    // Provider costs are never exposed to tenants.
    match /communicationRates/{rateId} { allow read: if superAdmin() || featureAdmin(); allow write: if false; }
    match /transactions/{txnId} {
      allow read, write: if featureAdmin() || superAdmin();
    }
    match /integrations/{integrationId} {
      allow read, write: if featureAdmin() || superAdmin();
    }
    match /settings/marketingTracking {
      allow read: if true;
      allow write: if signedIn() && profile().role in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin'] && validTracking();
    }
    function trackingWorkspaceMember(tenantId) {
      return signedIn() && (profile().get('tenantId', '') == tenantId || request.auth.token.get('tenantId', '') == tenantId) && member(tenantId).active == true;
    }
    function trackingWorkspaceManager(tenantId) {
      return featureAdmin() || trackingWorkspaceMember(tenantId) && (member(tenantId).get('role', '') == 'Owner' || member(tenantId).get('permissions', []).hasAny(['*', 'settings']) || get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('ownerUid', '') == request.auth.uid);
    }
    function validTracking() {
      let c = request.resource.data;
      return c.keys().hasOnly(['schemaVersion', 'metaId', 'googleId', 'enabled', 'customEvents', 'advancedMode', 'webhookUrl', 'updatedAt', 'updatedBy'])
        && c.get('schemaVersion', 1) == 1 && c.get('updatedBy', request.auth.uid) == request.auth.uid
        && c.metaId is string && (c.metaId == '' || c.metaId.matches('[0-9]{10,16}'))
        && c.googleId is string && (c.googleId == '' || c.googleId.matches('G-[A-Z0-9]{4,20}'))
        && c.enabled is bool && c.advancedMode is bool && c.customEvents is list && c.customEvents.size() <= 50
        && c.webhookUrl is string && c.webhookUrl.size() <= 1000 && (c.webhookUrl == '' || c.webhookUrl.matches('https://.*'));
    }
    // Template ownership: templateCatalog = super admin library ("General templates" for admins, read-only for them).
    function templateSuperAdmin() {
      return accountAvailable() && !platformStaff() && (
        request.auth.token.get('role', '') in ['SUPER_ADMIN', 'super_admin', 'platform_admin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('role', '') in ['SUPER_ADMIN', 'super_admin', 'platform_admin'])) || platformTeamCan(['templates']);
    }
    function validTemplate() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.category in ['Funnels', 'Websites', 'Forms', 'Landing Pages', 'Booking Pages', 'CRM Pipelines', 'AI Assistants', 'AI Knowledge Packs', 'Automations', 'Products', 'Email/SMS/WhatsApp']
        && request.resource.data.source == 'official'
        && request.resource.data.active is bool
        && request.resource.data.status in ['Published', 'Draft']
        && request.resource.data.content is map
        && request.resource.data.content.headline is string
        && request.resource.data.content.steps is list
        && request.resource.data.content.settings is map
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function myAdmin(adminUid) {
      return signedIn() && (request.auth.uid == adminUid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('supportParentId', '') == adminUid));
    }
    match /templateCatalog/{templateId} {
      allow read: if signedIn() || platformTeamCan(['templates']);
      allow create, update: if templateSuperAdmin() && validTemplate();
      allow delete: if templateSuperAdmin();
    }
    // An admin's own templates: only that admin edits; that admin's users read; the super admin reads all ("Client templates").
    match /adminTemplates/{templateId} {
      allow read: if templateSuperAdmin() || myAdmin(resource.data.ownerUid);
      allow create: if featureAdmin() && validTemplate() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if featureAdmin() && validTemplate() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if featureAdmin() && resource.data.ownerUid == request.auth.uid;
    }
    // General templates an admin hid from their own users.
    match /adminTemplateSettings/{adminUid} {
      allow read: if templateSuperAdmin() || myAdmin(adminUid);
      allow write: if featureAdmin() && request.auth.uid == adminUid
        && request.resource.data.keys().hasOnly(['hiddenGeneral', 'updatedAt']) && request.resource.data.hiddenGeneral is list;
    }

    // Published funnel websites (public live pages + custom domains)
    match /published_sites/{funnelId} {
      allow read: if true;
      allow write: if accountAvailable() && !platformStaff();
    }

    match /site_domains/{host} {
      allow read: if true;
      allow write: if accountAvailable() && !platformStaff();
    }
    match /users/{userId} {
      match /preferences/passwordPolicy {
        allow get: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['localPassword'])
          && request.resource.data.localPassword == true;
      }
      match /preferences/dashboard {
        allow get: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['language', 'currency', 'mode', 'timezone', 'dateFormat'])
          && request.resource.data.get('language', null) in [null, 'en', 'ar']
          && request.resource.data.get('mode', null) in [null, 'light', 'dark', 'system']
          && (request.resource.data.get('currency', null) == null || request.resource.data.currency.matches('[A-Z]{3}'))
          && (request.resource.data.get('timezone', null) == null || request.resource.data.timezone is string && request.resource.data.timezone.size() <= 100)
          && (request.resource.data.get('dateFormat', null) == null || request.resource.data.dateFormat in ['DD / MM / YYYY', 'MM / DD / YYYY', 'YYYY / MM / DD']);
      }
      match /preferences/marketingTracking {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId && validTracking();
      }
      // Phoenix snapshots are server-owned; only the linked user may read them.
      match /brandEngine/current {
        allow read: if platformOwner(userId);
        allow write: if false;
      }
      match /brandEngineSnapshots/{snapshotId} {
        allow read: if platformOwner(userId);
        allow write: if false;
        match /{document=**} {
          allow read: if platformOwner(userId);
          allow write: if false;
        }
      }
      // An invited user may read (and mark consumed) the invitation addressed to their own email,
      // even if it was provisioned under a different document ID.
      function ownInvite() { return request.auth != null && request.auth.token.email != null && resource.data.email == request.auth.token.email; }
      allow get: if request.auth != null && (request.auth.uid == userId || ownInvite() || superAdmin() || platformTeamCan(['overview', 'all_admins', 'team_management']) || featureAdmin() && resource.data.role == 'USER');
      allow list: if ownInvite() || superAdmin() || platformTeamCan(['overview', 'all_admins', 'team_management']) || featureAdmin() && resource.data.role == 'USER';
      // Roles, tenant ownership and account lifecycle are controlled by manageUser.
      allow create, delete: if false;
      allow update: if request.auth != null && request.auth.uid == userId
        && resource.data.status == 'Active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'activatedAt', 'tempAuthKey']);
    }
    match /tenants/{tenantId} {
      // Admin reads do not depend on membership documents in each client workspace.
      allow get, list: if featureAdmin() || superAdmin() || tenant(tenantId) || signedIn() && resource.data.get('accountType', '') != 'agency';
      match /{adminResource}/{adminRecord} {
        allow read: if (featureAdmin() || superAdmin() || tenant(tenantId) || permit(tenantId, 'settings')) && adminResource in ['products', 'calendars', 'bookings', 'contacts', 'leads', 'pipelines', 'conversations', 'messages', 'workflows', 'workflowRuns', 'scheduledActions', 'knowledge', 'templates', 'discounts', 'transactions', 'orders', 'checkoutRequests', 'events', 'integrations', 'auditLogs', 'assets', 'domains', 'userTemplates', 'files', 'handoffLogs', 'aiUsage', 'modelAllocations'];
      }
      match /preferences/general {
        allow get: if tenant(tenantId) || superAdmin();
        allow create, update: if (permit(tenantId, 'settings') || superAdmin())
          && request.resource.data.updatedBy == request.auth.uid
          && validDashboardBrand();
        allow delete: if signedIn() && (permit(tenantId, 'settings') || featureAdmin() || superAdmin());
      }
      match /businessAssets/{assetId} {
        allow read: if tenant(tenantId) || (signedIn() && !agencyWorkspace(tenantId) && !agencyUser());
        allow create, update: if (permit(tenantId, 'settings') || featureAdmin() || superAdmin())
          && request.resource.data.keys().hasOnly(['name', 'category', 'url', 'path', 'createdAt', 'createdBy'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 180
          && request.resource.data.category in ['Brand asset', 'Media kit', 'Knowledge resource']
          && request.resource.data.url is string && request.resource.data.url.size() <= 2000 && request.resource.data.url.matches('https://.*')
          && request.resource.data.createdBy == request.auth.uid
          && (!('path' in request.resource.data) || request.resource.data.path.matches('tenants/' + tenantId + '/branding/[^/]+'));
        allow delete: if permit(tenantId, 'settings') || featureAdmin() || superAdmin();
      }
      match /{resource}/{recordId} {
        allow read: if resource in ['handoffLogs', 'aiUsage', 'modelAllocations', 'integrations', 'auditLogs', 'transactions'] && (featureAdmin() || superAdmin() || permit(tenantId, 'analytics') || permit(tenantId, 'settings') || tenant(tenantId) || (resource == 'handoffLogs' && permit(tenantId, 'inbox')));
        allow write: if false;
      }
      match /preferences/marketingTracking {
        allow read: if featureAdmin() || trackingWorkspaceMember(tenantId);
        allow create, update: if trackingWorkspaceManager(tenantId) && validTracking();
        allow delete: if trackingWorkspaceManager(tenantId);
      }
      allow read: if request.auth != null && request.auth.token.tenantId == tenantId
        && platformOwner(resource.data.ownerUid);
      allow read: if tenant(tenantId) || signedIn() && (profile().role == 'SUPER_ADMIN' || profile().role == 'ADMIN');
      function tenantAdmin() { return signedIn() && profile().role in ['SUPER_ADMIN', 'ADMIN']; }
      allow create: if tenantAdmin() && request.resource.data.get('accountType', '') != 'agency'
        && !request.resource.data.keys().hasAny(['billingOwnerId', 'agencyLandingSeeded']);
      allow update: if tenantAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billingOwnerId', 'agencyLandingSeeded'])
        && (resource.data.get('accountType', '') != 'agency' && request.resource.data.get('accountType', '') != 'agency'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'ownerId', 'ownerUid']));
      allow delete: if tenantAdmin() && resource.data.get('accountType', '') != 'agency';
      match /members/{userId} {
        allow read: if tenant(tenantId) || signedIn() && (profile().role == 'SUPER_ADMIN' || profile().role == 'ADMIN');
        allow create, delete: if false;
        allow update: if tenant(tenantId) && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'name', 'email', 'updatedAt']);
      }
      match /workspaceState/{stateId} {
        function isProfileSettings() { return stateId.matches('gos-settings-v1%3A.*'); }
        function ownProfileSettings() {
          return tenant(tenantId) && stateId == 'gos-settings-v1%3A' + tenantId + '%3A' + request.auth.uid;
        }
        allow read: if tenant(tenantId) && !isProfileSettings() || ownProfileSettings();
        allow create, update: if ownProfileSettings()
          && request.resource.data.keys().hasOnly(['key', 'value', 'updatedAt', 'updatedBy'])
          && request.resource.data.key == 'gos-settings-v1:' + tenantId + ':' + request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.value is map;
        // Transitional editor preferences. Canonical financial/access records are never writable here.
        allow create, update: if stateId != 'gos.agency.landing-seed.v1' && request.resource.data.key != 'gos.agency.landing-seed.v1'
          && !isProfileSettings() && (permit(tenantId, 'settings') || tenant(tenantId) && request.resource.data.key == 'gos.notifications.v1:' + request.auth.uid || permit(tenantId, 'products') && request.resource.data.key.matches('gos-commerce-products-v1:.*:preview:.*')) && request.resource.data.keys().hasOnly(['key', 'value', 'updatedAt', 'updatedBy']) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.key.matches('gos[-._].*') && !request.resource.data.key.matches('.*(transactions|purchased|security|billing).*');
        allow delete: if stateId != 'gos.agency.landing-seed.v1' && !isProfileSettings() && permit(tenantId, 'settings');
      }
      match /products/{productId}/publicReviews/current {
        // Public review projection contains no customer emails or order data.
        allow read: if permit(tenantId, 'products') ||
          get(/databases/$(database)/documents/tenants/$(tenantId)/products/$(productId)).data.status == 'Active' &&
          get(/databases/$(database)/documents/tenants/$(tenantId)/products/$(productId)).data.config.experience.get('visibility', 'Published') in ['Published', 'Unlisted'];
        allow write: if false;
      }
      match /products/{productId} {
        allow create: if permit(tenantId, 'products') && !request.resource.data.keys().hasAny(['reviews', 'ratingAverage', 'reviewsCount', 'ratingTotal']);
        allow update: if permit(tenantId, 'products') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviews', 'ratingAverage', 'reviewsCount', 'ratingTotal']);
        allow delete: if permit(tenantId, 'products');
      }
      match /domains/{domainId} {
        // Provider verification and domain assignments are server-owned.
        allow update: if permit(tenantId, 'funnels')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['default'])
          && request.resource.data.default is bool
          && (!request.resource.data.default || resource.data.status == 'Connected' && resource.data.ssl == 'Active');
        allow delete: if permit(tenantId, 'funnels');
      }
      match /assets/{assetId} {
        allow create: if permit(tenantId, 'funnels');
        allow update: if permit(tenantId, 'funnels');
        allow delete: if permit(tenantId, 'funnels');
      }
      match /checkoutRequests/{requestId} {
        allow read: if featureAdmin() || superAdmin() || permit(tenantId, 'products') || tenant(tenantId) || (
          request.auth.token.get('tenantId', '') == tenantId ||
          profile().get('tenantId', '') == tenantId ||
          exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        );
        allow write: if false;
      }
      match /{collectionName}/{id} {
        allow read: if (featureAdmin() || superAdmin() || (tenant(tenantId) && canRead(tenantId, collectionName))) && (collectionName != 'copilotConversations' || resource.data.actorId == request.auth.uid) && collectionName in ['products', 'calendars', 'bookings', 'contacts', 'leads', 'pipelines', 'conversations', 'messages', 'workflows', 'workflowRuns', 'scheduledActions', 'knowledge', 'templates', 'discounts', 'transactions', 'orders', 'checkoutRequests', 'events', 'integrations', 'auditLogs', 'assets', 'domains', 'copilotConversations', 'userTemplates', 'files', 'handoffLogs', 'aiUsage', 'modelAllocations'];
        allow create, update, delete: if (
          collectionName in ['knowledge', 'integrations', 'auditLogs'] && (featureAdmin() || superAdmin() || permit(tenantId, 'settings') || permit(tenantId, 'products') || tenant(tenantId)) ||
          collectionName == 'calendars' && permit(tenantId, 'booking') ||
          collectionName in ['leads', 'contacts', 'pipelines'] && permit(tenantId, 'crm') ||
          collectionName == 'conversations' && permit(tenantId, 'inbox') ||
          collectionName in ['workflows', 'templates'] && permit(tenantId, 'follow-up') ||
          collectionName == 'userTemplates' && permit(tenantId, 'home') ||
          collectionName == 'files' && permit(tenantId, 'products')
        );
        allow create: if collectionName == 'events' && (tenant(tenantId) || featureAdmin() || superAdmin()) && request.resource.data.actorId == request.auth.uid && request.resource.data.type == 'workspace.updated';
      }
      match /paymentMethods/{docId} {
        allow read: if true;
        allow create, update, delete: if featureAdmin() || superAdmin() || permit(tenantId, 'settings') || permit(tenantId, 'products') || tenant(tenantId);
      }
      match /discounts/{discountId} {
        allow create: if permit(tenantId, 'products') && request.resource.data.get('uses', 0) == 0;
        allow update: if permit(tenantId, 'products') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uses']);
        allow delete: if permit(tenantId, 'products');
      }
    }
    match /workspaces/{workspaceId} {
      allow read: if signedIn() || platformTeamCan(['templates']);
      allow write: if featureAdmin() || superAdmin() || (signedIn() && (request.auth.uid == workspaceId || tenant(workspaceId)));
      match /{allChildren=**} {
        allow read: if signedIn() || platformTeamCan(['templates']);
        allow write: if featureAdmin() || superAdmin() || (signedIn() && (request.auth.uid == workspaceId || tenant(workspaceId)));
      }
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if featureAdmin() || superAdmin() || signedIn() || platformRole(['SUPER_ADMIN', 'PLATFORM_SUPPORT', 'PLATFORM_FINANCE']);
      match /{allChildren=**} {
        allow read: if true;
        allow write: if featureAdmin() || superAdmin() || signedIn() || platformRole(['SUPER_ADMIN', 'PLATFORM_SUPPORT', 'PLATFORM_FINANCE']);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}

