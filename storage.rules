rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{photoId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/gif'];
    }
    match /tenants/{tenantId}/branding/{fileId} {
      function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
      function member() { return firestore.get(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data; }
      function workspace() { return firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data; }
      function manager() {
        return request.auth != null && profile().get('status', 'Active') in ['Active', 'active', 'Activated', 'activated'] && (profile().get('role', '') in ['ADMIN', 'SUPER_ADMIN']
          || workspace().get('ownerUid', '') == request.auth.uid || workspace().get('ownerId', '') == request.auth.uid
          || member().get('active', false) && (member().get('role', '') == 'Owner' || member().get('permissions', []).hasAny(['*', 'settings'])));
      }
      allow read: if request.auth != null && profile().get('status', 'Active') in ['Active', 'active', 'Activated', 'activated'] && (profile().get('tenantId', '') == tenantId || member().get('active', false) || manager());
      allow create: if manager() && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml', 'application/pdf', 'text/plain'];
      allow delete: if manager();
      allow update: if false;
    }
    match /supportAttachments/{roomId}/{authorId}/{fileName} {
      function participant() {
        return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'Active' && request.auth.uid in firestore.get(/databases/(default)/documents/supportRooms/$(roomId)).data.participants;
      }
      allow read: if participant();
      allow create: if participant() && authorId == request.auth.uid && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /billingReceipts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId && request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /tenants/{tenantId}/commerce/{allPaths=**} {
      function workspaceAccount() {
        let profileRef = /databases/(default)/documents/users/$(request.auth.uid);
        let memberRef = /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
        let profile = firestore.get(profileRef).data;
        return request.auth.token.get('role', '') != 'CUSTOMER'
          && !(profile.get('role', '') in ['PLATFORM_SUPPORT', 'PLATFORM_FINANCE', 'CUSTOMER'])
          && !(profile.get('status', '') in ['Deactivated', 'Inactive', 'Suspended', 'Deleted'])
          && (request.auth.uid == tenantId || profile.get('tenantId', '') == tenantId
            || request.auth.token.get('tenantId', '') == tenantId || profile.get('role', '') in ['ADMIN', 'SUPER_ADMIN']
            || firestore.get(memberRef).data.get('active', false));
      }
      allow read, write: if request.auth != null && workspaceAccount();
    }
    // Template gallery images. System templates (super admin library) and each admin's own templates.
    function templateRole() {
      return request.auth.token.get('role', '') != '' ? request.auth.token.get('role', '')
        : firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '');
    }
    function templateImage() {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
    }
    match /templateThumbnails/{templateId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && templateRole() in ['SUPER_ADMIN', 'super_admin', 'platform_admin'] && templateImage();
      allow delete: if request.auth != null && templateRole() in ['SUPER_ADMIN', 'super_admin', 'platform_admin'];
    }
    match /templateThumbnails/admins/{adminUid}/{templateId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == adminUid && templateRole() in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin', 'Admin', 'platform_admin'] && templateImage();
      allow delete: if request.auth != null && request.auth.uid == adminUid;
    }
    // Launch Brand (moved from Joe Academy): logo/brand images, read by their owner only.
    match /users/{uid}/brandAssets/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.launchBrand == true;
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
